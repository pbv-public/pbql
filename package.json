{
  "name": "@pbvision/pbql",
  "version": "0.14.2",
  "description": "PBQL is a SQL-like language for querying shots in pickleball games analyzed by PB Vision.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "browser": "./src/browser.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pbql": "./bin/pbql.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "build": "bash scripts/compile-parser.sh",
    "build:site": "yarn -s build && node docs-site/build.js",
    "coverage": "yarn -s test --coverage",
    "debug": "INDEBUGGER=1 ./node_modules/nodemon/bin/nodemon.js --no-lazy --legacy-watch --watch ./src --watch ./test --exec 'node --inspect=9229 --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=./jest.config.json --runInBand'",
    "docs": "node scripts/gen-docs.js",
    "lint": "eslint . --ext js,jsx --ignore-pattern 'src/lang/grammar-generated.js' --report-unused-disable-directives --max-warnings 0",
    "prepack": "yarn -s build",
    "pretest": "yarn -s build",
    "setup": "yarn install --frozen-lockfile",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config=./jest.config.json",
    "watch": "yarn -s test --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pbv-public/pbql"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.17.12",
    "@babel/eslint-parser": "^7.17.0",
    "@babel/preset-env": "^7.17.12",
    "@pbvision/jest-unit-test": "^0.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.22.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "marked": "^18.0.6",
    "nodemon": "^3.0.3",
    "standard": "^17.1.0"
  },
  "standard": {
    "envs": [
      "jest"
    ],
    "globals": [
      "fail"
    ],
    "ignore": [
      "**/node_modules/**"
    ],
    "parser": "@babel/eslint-parser"
  }
}
