# NL → PBQL example corpus. Each example starts with a "# Q:" line holding
# the natural-language question; the query follows. These feed docs/llms.txt
# (via `yarn docs`) and the parser corpus tests, so every example must parse.

# Q: Show me all my drop shots
FROM "83gyqyc10y8f"
WHERE shot.type = "drop" AND shot.hitter = me

# Q: My highest-quality shots, best first, top 20
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.quality.overall >= 0.8
ORDER BY shot.quality.overall DESC
LIMIT 20

# Q: My shots hit under heavy positional pressure
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.quality.pressure >= 0.7

# Q: Shots where I was badly out of position
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.positioningScore < 0.5

# Q: Every dink or drop across my whole folder
FROM "./games"
WHERE shot.type IN ("dink", "drop")

# Q: Third shots from game 2 of this video
FROM "83gyqyc10y8f:2"
WHERE shot.num = 3

# Q: Serves that landed deep
FROM "83gyqyc10y8f"
WHERE shot.num = 1 AND shot.to.zone = "deep"

# Q: Shots faster than 40 mph with a bit of lead-in video
FROM "83gyqyc10y8f"
WHERE shot.speed > 40
CONTEXT BEFORE 2secs
CONTEXT AFTER 1.5secs

# Q: Anna's winners, with the shot before each one for context
FROM "83gyqyc10y8f"
WHERE shot.taggedWith("Anna*") AND exists(shot.winnerType)
CONTEXT BEFORE 1 shot

# Q: Every shot of every rally I won, whole rallies as clips
FROM "83gyqyc10y8f"
WHERE rally.winner = me.team
CONTEXT BEFORE rally
CONTEXT AFTER rally

# Q: My unforced errors
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.errors.unforced

# Q: Balls I hit out that the other team played anyway
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.errors.faults.out.outcome = "intercepted"

# Q: Clean shots — exclude anything with a detected error
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND NOT shot.hasError

# Q: Shots that did NOT go into the net (fault flags are never unknown, so NOT is safe)
FROM "83gyqyc10y8f"
WHERE NOT shot.errors.faults.net

# Q: Volleys my opponents hit while I was at the kitchen line
FROM "83gyqyc10y8f"
WHERE shot.hitter.team != me.team AND shot.isVolley AND me.feetToKitchen = 0

# Q: Left-side (typically backhand) speedups by either player on my team
FROM "83gyqyc10y8f"
WHERE shot.hitter.team = me.team AND shot.isSpeedup AND shot.strokeSide = "left"

# Q: Around-the-post highlights
FROM "83gyqyc10y8f"
WHERE shot.inHighlight("atp")
CONTEXT BEFORE min(2 shots, 4secs)
CONTEXT AFTER 2secs

# Q: Long rallies (12+ shots) that my team lost
FROM "83gyqyc10y8f"
WHERE rally.numShots >= 12 AND rally.winner != me.team

# Q: Dinks that popped up and got punished
FROM "83gyqyc10y8f"
WHERE shot.type = "dink" AND shot.errors.popup = "exploited"

# Q: Shots where the ball traveled more than 15 feet sideways
FROM "83gyqyc10y8f"
WHERE abs(shot.to.absX - shot.from.absX) > 15

# Q: Serves hit from within 2 feet of the right sideline
FROM "83gyqyc10y8f"
WHERE shot.num = 1 AND shot.from.feetToNearestSideline <= 2 AND shot.from.x > 10

# Q: The shot right before every one of my resets, in the first ten rallies
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.isReset AND shot[-1].speed > 30 AND rally.num <= 10

# Q: Shots by the player with email pat@example.com in either of two videos
FROM "83gyqyc10y8f", "jhc3t8h8b5cj"
WHERE shot.taggedWith("pat@example.com")

# Q: What speed and quality did each of my drives have? (spreadsheet)
SELECT shot.hitTime AS "when (s)", shot.speed AS "mph", shot.quality.overall
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.type = "drive"
ORDER BY shot.speed DESC

# Q: When was each rally-ending shot hit, as a video timecode?
SELECT timecode(shot.hitTime) AS "when", shot.hitter.name
FROM "83gyqyc10y8f"
WHERE shot.isFinal

# Q: How many shots did I hit in this game?
SELECT count()
FROM "83gyqyc10y8f"
WHERE shot.hitter = me

# Q: Shots where my whole team was at the kitchen but we still lost the rally
FROM "83gyqyc10y8f"
WHERE me.feetToKitchen = 0 AND me.teammate.feetToKitchen = 0 AND rally.winner != me.team

# Q: Third-shot drops that landed short of the kitchen with low pace
FROM "83gyqyc10y8f"
WHERE shot.num = 3 AND shot.type = "drop" AND shot.to.zone IN ("kitchen", "short") AND shot.speed < 25

# Q: Every ball we hit at the opponents' left-side player's feet
FROM "83gyqyc10y8f"
WHERE shot.hitter.team = me.team AND me.opponentLHS.feetToNet <= 14 AND shot.to.zone != "out"

# Q: Balls launched exactly level or one degree downward
FROM "83gyqyc10y8f"
WHERE shot.pitch IN (0, -1)

# Q: The setup shots where I fed my partner the ball they put away for a winner
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot[1].hitter = me.teammate AND exists(shot[1].winnerType)

# Q: Balls Ben hit right at the opponents' left-side player
FROM "83gyqyc10y8f"
WHERE shot.hitter.taggedWith("Ben*") AND shot.to.zone != "out" AND shot.hitter.opponentLHS.feetToNet <= 14

# Q: What fraction of rallies did my team win? (one number)
SELECT avg(rally.winner = me.team) AS "win rate"
FROM "83gyqyc10y8f"
WHERE shot.num = 1

# Q: How often did my team win the rally when we served? (serving happens once per rally, so one avg works)
SELECT avg(rally.winner = me.team) AS "win rate when we serve"
FROM "83gyqyc10y8f"
WHERE shot.num = 1 AND shot.hitter.team = me.team

# Q: Rallies where I hit at least one drop, with each rally's winner — drops repeat within a rally, so dedupe these rows before computing a win rate
SELECT rally.num, rally.winner
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.type = "drop"

# Q: My win rate by shot type — how do rallies go when I hit each kind of shot?
SELECT shot.type, avg(rally.winner = me.team) AS "win rate", count()
FROM "83gyqyc10y8f"
WHERE shot.hitter = me
GROUP BY shot.type

# Q: Joe's win rate by the shot type he hit (his team, whichever side he played)
SELECT shot.type, avg(rally.winner = shot.hitter.team) * 100 AS "win %", count()
FROM "83gyqyc10y8f"
WHERE shot.hitter.name = "Joe"
GROUP BY shot.type

# Q: What percentage of rallies does my team win by the shot type I open with?
SELECT shot.type, avg(rally.winner = me.team) * 100 AS "win %"
FROM "83gyqyc10y8f"
WHERE shot.num = 1 AND shot.hitter = me
GROUP BY shot.type

# Q: How much faster is my hardest shot than my softest one?
SELECT max(shot.speed) - min(shot.speed) AS "mph spread"
FROM "83gyqyc10y8f"
WHERE shot.hitter = me

# Q: Average ball speed for each stroke side, fastest first
SELECT shot.strokeSide, avg(shot.speed) AS "mph"
FROM "83gyqyc10y8f"
WHERE exists(shot.speed)
GROUP BY shot.strokeSide
ORDER BY avg(shot.speed) DESC

# Q: My serves in the second half of the game (by the clock)
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.num = 1 AND shot.hitTime >= game.startTime + game.duration / 2

# Q: Shots from the second half of the game's rallies
FROM "83gyqyc10y8f"
WHERE rally.num > game.numRallies / 2

# Q: Shots from every rally that came right after a rally my team lost
FROM "83gyqyc10y8f"
WHERE exists(rally[-1].winner) AND rally[-1].winner != me.team

# Q: Shots from rallies where my team went on to win the very next rally
FROM "83gyqyc10y8f"
WHERE rally[1].winner = me.team

# Q: The five fastest shots
FROM "83gyqyc10y8f"
WHERE exists(shot.speed)
ORDER BY shot.speed DESC
LIMIT 5

# Q: Shots that weren't confirmed volleys, including ones with no volley data
FROM "83gyqyc10y8f"
WHERE NOT shot.isVolley OR NOT exists(shot.isVolley)

# Q: Whole rallies we lost in which I dinked from the right side
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.type = "dink" AND shot.isHitOnSide("right") AND rally.winner != me.team
CONTEXT BEFORE rally
CONTEXT AFTER rally

# Q: Every shot from rallies we lost (the shots themselves, not whole-rally clips)
FROM "83gyqyc10y8f"
WHERE rally.winner != me.team

# Q: Show me everything about my serves as a table
SELECT *
FROM "83gyqyc10y8f"
WHERE shot.hitter = me AND shot.num = 1

# Q: Rally numbers and shot counts for rallies with at least four shots
SELECT rally.num, count()
FROM "83gyqyc10y8f"
WHERE shot.num >= 1
GROUP BY rally.num
HAVING count() >= 4

# Q: Rallies we lost where I dinked at least three times
FROM "83gyqyc10y8f"
WHERE rally.winner != me.team AND rally.count(shot.hitter = me AND shot.type = "dink") >= 3
CONTEXT BEFORE rally
CONTEXT AFTER rally

# Q: How many shots did I hit each day I played?
SELECT date(game.epoch) AS "day", count()
FROM "games/*.json"
WHERE shot.hitter = me
GROUP BY date(game.epoch)
ORDER BY min(game.epoch)
